        <value>// x_casemgmt ATF - server-side assertion block.
// Aggregates every individual check and reports them through ONE assertion so
// that a failure message names precisely which expectation broke.
(function(outputs, steps, params, stepResult, assertEqual) {
    var fails = [], checks = 0;
    function chk(name, expected, actual) {
        checks++;
        if (String(expected) !== String(actual))
            fails.push(name + ' expected[' + expected + '] actual[' + actual + ']');
    }
    function chkTrue(name, actual) { chk(name, 'true', String(actual)); }
    function dict(table, element) {
        var d = new GlideRecord('sys_dictionary');
        d.addQuery('name', table); d.addQuery('element', element); d.setLimit(1); d.query();
        return d.next() ? d : null;
    }
    function choices(table, element) {
        var out = [], c = new GlideRecord('sys_choice');
        c.addQuery('name', table); c.addQuery('element', element); c.orderBy('sequence'); c.query();
        while (c.next()) out.push(c.getValue('value'));
        return out;
    }

    function anonCall(method, path, body) {
        var r = new sn_ws.RESTMessageV2();
        r.setHttpMethod(method);
        r.setEndpoint(String(gs.getProperty('glide.servlet.uri')).replace(/\/$/, '') + path);
        r.setRequestHeader('Accept', 'application/json');
        if (body) {
            r.setRequestHeader('Content-Type', 'application/json');
            r.setRequestBody(body);
        }
        var resp = r.execute();
        return { status: String(resp.getStatusCode()), body: String(resp.getBody() || '') };
    }

    var res = anonCall('post', '/api/x_casemgmt/case_submit', '{"subject":"ATF-PORTAL-18 anonymous submission","type":"General Inquiry","description":"Synthetic ATF portal submission. No PII.","requester_name":"ATF Synthetic Requester","requester_email":"atf-portal@example.invalid"}');
    chk('anonymous submit status', '201', res.status);
    var parsed = JSON.parse(res.body).result;
    chkTrue('anonymous response carries a number', /^CASE[0-9]{7}$/.test(String(parsed.number)));
    chk('anonymous response message is verbatim', 'Your case has been submitted', String(parsed.message));
    var created = new GlideRecord('x_casemgmt_case');
    chkTrue('the anonymously created case exists', created.get('number', String(parsed.number)));
    chk('the anonymously created case is Draft', 'Draft', created.getValue('status'));
    chk('the whitelist forced the subject through unchanged', 'ATF-PORTAL-18 anonymous submission',
        created.getValue('subject'));
    stepResult.setOutputMessage('anonymous 201 body: ' + res.body);
    stepResult.setOutputMessage('genuinely anonymous submit with no credentials: checks=' + checks + ' failures=' + fails.length +
        (fails.length ? ' :: ' + fails.join(' | ') : ''));
    return assertEqual({ name: 'genuinely anonymous submit with no credentials', shouldbe: '', value: fails.join(' | ') });
})(outputs, steps, params, stepResult, assertEqual);
</value>
