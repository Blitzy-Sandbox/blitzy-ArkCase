          <sys_scope display_value="Case Management">
              82b99028936f74320d74d6f88357a5af</sys_scope>
          (body = the scoped application's own sys_scope sys_id)
          <sys_package display_value="Case Management" source="x_casemgmt">
              x_casemgmt</sys_package>
        The <sys_id> below is this record's OWN primary key (deterministic
